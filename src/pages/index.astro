---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, navigation, education, skills } from '../data/profile';
import { projects } from '../data/projects';
---
<BaseLayout title={`${profile.name} / ${profile.englishName}`} description={profile.description}>
  <header class="site-header wrap">
    <a class="wordmark" href="#about" aria-label="钱星宇，回到个人介绍">XQ<span aria-hidden="true">.</span></a>
    <nav aria-label="主要导航">
      {navigation.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>
  </header>

  <main id="main" class="wrap" tabindex="-1">
    <section id="about" class="hero" aria-labelledby="about-title">
      <p class="eyebrow">{profile.title}</p>
      <h1 id="about-title">{profile.name}<span lang="en">{profile.englishName}</span></h1>
      <p class="intro">{profile.about}</p>
      <p class="focus-line" lang="en">Agent Harness / Context Engineering / Agent Reliability</p>
      <div class="hero-links">
        <a class="button" href="#projects">浏览项目 <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="section-heading"><p class="eyebrow">Selected Projects</p><h2 id="projects-title">代表项目</h2></div>
      <div>{projects.map(project => <ProjectCard project={project} />)}</div>
    </section>

    <section id="education" class="section" aria-labelledby="education-title">
      <div class="section-heading"><p class="eyebrow">Education</p><h2 id="education-title">教育背景</h2></div>
      <ol class="education-list">
        {education.map(item => (
          <li>
            <h3>{item.school}</h3>
            <p>{item.degree}</p>
            {item.department && <p class="muted">{item.department}</p>}
            <p class="period">{item.period}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="section" aria-labelledby="skills-title">
      <div class="section-heading"><p class="eyebrow">Technical Skills</p><h2 id="skills-title">技术关注</h2></div>
      <ul class="skills-list">
        {skills.map(skill => <li><h3 lang="en">{skill.name}</h3><p class="muted">{skill.detail}</p></li>)}
      </ul>
    </section>

    <section id="contact" class="section contact" aria-labelledby="contact-title">
      <div class="section-heading"><p class="eyebrow">Contact</p><h2 id="contact-title">保持联系</h2></div>
      <div>
        <p class="contact-intro">欢迎交流项目、技术想法与职业机会。</p>
        <address>
          <a class="contact-link" href={`mailto:${profile.email}`}><span>邮箱</span>{profile.email}<span aria-hidden="true">↗</span></a>
          <a class="contact-link" href={profile.github}><span>GitHub</span>github.com/729194587<span aria-hidden="true">↗</span></a>
        </address>
      </div>
    </section>
  </main>
  <footer class="site-footer wrap"><span>© {new Date().getFullYear()} {profile.englishName}</span><a href="#about">回到顶部 ↑</a></footer>
</BaseLayout>
