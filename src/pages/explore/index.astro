---
import Layout from '../../layouts/ExplorationLayout.astro';
const directions = [
 {id:'editorial',no:'01',title:'学术编辑部',en:'The Editorial',description:'以个人刊物为灵感，用衬线字体、纸色与清晰的编辑层级，把人和项目放在阅读中心。',keywords:'书刊排版 / 温暖克制 / 内容优先'},
 {id:'systems',no:'02',title:'系统实验室',en:'The Systems Lab',description:'以工程工作台为灵感，固定索引与项目主题图共同组织信息，让技术方向成为第一印象。',keywords:'工程结构 / 深色界面 / 项目优先'},
 {id:'canvas',no:'03',title:'开放画布',en:'The Open Canvas',description:'用非对称构图和抽象纸片表达思考与构建，兼顾技术履历与未来个人空间的延展。',keywords:'图形构成 / 亲和表达 / 个人气质'},
];
---
<Layout title="三种视觉方向">
 <main id="main" tabindex="-1">
  <p class="eyebrow">XINGYU QIAN / DESIGN EXPLORATION</p><h1>同一个人，<br/>三种表达。</h1><p class="intro">三个独立设计原型。内容相同，阅读节奏、信息结构与视觉气质各不相同。<br/>当前正式首页保持不变。</p>
  <div class="directions">{directions.map(d=><a class:list={['direction',d.id]} href={`/explore/${d.id}/`}><div class="preview" aria-hidden="true">{d.id==='editorial'?<><small>PERSONAL ARCHIVE / 01</small><strong>Xingyu<br/>Qian.</strong><i></i></>:d.id==='systems'?<><small>XQ_ / SYSTEMS</small><strong>Agent<br/><span>Reliability.</span></strong><div class="nodes"><i></i><i></i><i></i></div></>:<><div class="shape one"></div><div class="shape two"></div><strong>思考。<br/>构建。</strong></>}</div><div class="description"><p>{d.no} / {d.en}<span>↗</span></p><h2>{d.title}</h2><p>{d.description}</p><small>{d.keywords}</small></div></a>)}</div>
  <footer><p>建议先完整浏览，再比较：第一印象、项目可读性、个人气质与长期扩展。</p><a href="/">查看当前正式设计 ↗</a></footer>
 </main>
</Layout>
<style>
 :global(body) { background:#f6f6f3; color:#262628; } main { max-width:1240px; width:calc(100% - 80px); margin:70px auto 30px; } .eyebrow { font-size:10px; letter-spacing:.16em; color:#69696c; } h1 { font-size:clamp(40px,5vw,64px); font-weight:550; letter-spacing:-.05em; line-height:1.25; margin:24px 0; } .intro { font-size:14px; color:#65656b; line-height:1.9; } .directions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; margin:50px 0; } .direction { text-decoration:none; border:1px solid #d8d8d4; background:white; } .direction:hover { border-color:#555; } .preview { min-height:280px; padding:28px; position:relative; overflow:hidden; } .preview small { font:9px/1.5 Consolas,monospace; letter-spacing:.06em; } .preview strong { display:block; margin:32px 0 15px; font-size:52px; line-height:.95; letter-spacing:-.06em; font-weight:400; } .editorial .preview { background:#f4f0e7; color:#27231f; } .editorial strong { font-family:Georgia,serif; } .editorial i { display:block; border-top:2px solid #a4422b; width:60%; margin-top:26px; } .systems .preview { background:#111717; color:#e9eeeb; } .systems strong { font-size:36px; line-height:1.15; font-weight:500; } .systems strong span { color:#c7f277; } .nodes { display:flex; gap:10px; margin-top:30px; } .nodes i { width:25%; height:24px; border:1px solid #8dac68; } .canvas .preview { background:#e9edfd; } .canvas strong { position:relative; font-size:44px; line-height:1.3; color:#fff; z-index:1; margin:50px 0 0 25px; } .shape { position:absolute; } .one { background:#db673d; border-radius:50%; width:130px; height:130px; right:15px; top:25px; } .two { background:#374bd0; width:175px; height:190px; top:62px; left:36px; transform:rotate(-10deg); } .description { padding:24px; } .description>p:first-child { font:10px/1.5 Consolas,monospace; display:flex; justify-content:space-between; } h2 { font-size:25px; font-weight:550; margin:20px 0 14px; } .description>p { font-size:13px; color:#5c5c62; } .description small { display:block; margin-top:24px; font-size:10px; color:#707078; } footer { display:flex; justify-content:space-between; gap:20px; border-top:1px solid #d8d8d4; padding-top:24px; font-size:11px; color:#65656b; } @media(max-width:850px) { .directions { grid-template-columns:1fr; } .direction { display:grid; grid-template-columns:1fr 1fr; } } @media(max-width:550px) { main { width:calc(100% - 40px); margin-top:40px; } .direction { display:block; } footer { flex-direction:column; } }
</style>
