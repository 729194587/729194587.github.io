---
import Layout from '../../layouts/ExplorationLayout.astro';
import { profile, education, skills } from '../../data/profile';
import { projects } from '../../data/projects';
---
<Layout title="02 · 系统实验室" direction="systems">
  <div class="lab">
    <aside class="rail"><a class="monogram" href="#main" aria-label="钱星宇">xq<span>_</span></a><div><p class="rail-label">PERSONAL / INDEX</p><nav aria-label="页面导航"><a href="#main">01 <span>概览</span></a><a href="#project">02 <span>项目</span></a><a href="#focus">03 <span>技术关注</span></a><a href="#education">04 <span>教育</span></a><a href="#contact">05 <span>联系</span></a></nav></div><a class="rail-github" href={profile.github}>GITHUB ↗</a></aside>
    <main id="main" tabindex="-1">
      <header class="topline"><span>钱星宇 / XINGYU QIAN</span><span>SOFTWARE ENGINEERING</span></header>
      <section class="overview" aria-labelledby="title"><p class="label">北京大学 · 软件工程硕士在读</p><h1 id="title">关注智能体的<br/><span>运行与可靠性。</span></h1><div class="overview-bottom"><p>{profile.about}</p><a href="#project">探索 TinyHarness <span>↙</span></a></div></section>
      <section id="project" aria-labelledby="project-title" class="project">
        <div class="section-label"><h2 id="project-title">02 / SELECTED PROJECT</h2><span>开源项目</span></div>
        {projects.map(project=><article><div class="project-heading"><div><p class="label">轻量 CODING AGENT HARNESS</p><h3>{project.name}</h3></div><a href={project.url} aria-label="在 GitHub 查看 TinyHarness">↗</a></div><p class="description">{project.description}</p><figure class="system-map"><figcaption>关注范围 / TOPIC MAP <span>主题关系示意 · 非架构或运行状态</span></figcaption><div class="map"><div class="map-node">TOOLS<small>工具执行</small></div><span class="connector" aria-hidden="true">—</span><div class="map-core">TinyHarness<small>Coding Agent Harness</small></div><span class="connector" aria-hidden="true">—</span><div class="map-node">CONTEXT<small>上下文管理</small></div></div><div class="map-foot"><span>权限控制</span><span>故障恢复</span><span>SWE-bench 评测</span></div></figure><a class="repo" href={project.url}>github.com/729194587/tiny_harness <span>↗</span></a></article>)}
      </section>
      <section id="focus" class="focus" aria-labelledby="focus-title"><div class="section-label"><h2 id="focus-title">03 / 技术关注</h2><span>AREAS OF INTEREST</span></div><div class="focus-grid">{skills.map((skill,i)=><article><span class="number">0{i+1}</span><h3>{skill.name}</h3><p>{skill.detail}</p></article>)}</div></section>
      <section id="education" aria-labelledby="edu-title"><div class="section-label"><h2 id="edu-title">04 / 教育背景</h2></div>{education.map(item=><article class="education"><p>{item.period}</p><div><h3>{item.school}</h3><p>{item.degree}</p>{item.department&&<p class="department">{item.department}</p>}</div><span aria-hidden="true">↗</span></article>)}</section>
      <footer id="contact"><p class="label">05 / CONTACT</p><h2>Let's connect<span>.</span></h2><address><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={profile.github}>GitHub ↗</a></address><p class="footer-note">欢迎交流项目、技术想法与职业机会。</p></footer>
    </main>
  </div>
</Layout>
<style>
 :global(body) { background:#111717; color:#e9eeeb; } .lab { display:grid; grid-template-columns:220px minmax(0,1fr); max-width:1500px; margin:auto; }
 .rail { padding:42px 30px; border-right:1px solid #34403d; display:flex; flex-direction:column; gap:80px; align-self:start; position:sticky; top:0; min-height:calc(100vh - 50px); }
 .monogram { font:700 36px/1 Consolas,monospace; text-decoration:none; letter-spacing:-4px; } .monogram span { color:#c7f277; }
 .rail-label,.label { font:11px/1.6 Consolas,monospace; letter-spacing:.07em; color:#a5b5ae; }
 .rail nav { margin-top:20px; display:grid; gap:5px; } .rail nav a { font:11px/1.5 Consolas,monospace; color:#9bacA3; padding:10px 0; text-decoration:none; } .rail nav a span { margin-left:20px; font:13px/1.5 sans-serif; color:#e9eeeb; } .rail nav a:hover span { color:#c7f277; } .rail-github { margin-top:auto; font:11px Consolas,monospace; }
 main { padding:0 56px; min-width:0; } .topline { display:flex; justify-content:space-between; gap:16px; padding:26px 0; border-bottom:1px solid #34403d; font:10px/1.7 Consolas,monospace; color:#a5b5ae; }
 .overview { padding:52px 0; } h1 { font-size:clamp(34px,4.5vw,64px); font-weight:550; letter-spacing:-.05em; line-height:1.3; margin:24px 0 30px; } h1>span { color:#c7f277; }
 .overview-bottom { display:grid; grid-template-columns:1fr auto; gap:40px; align-items:end; } .overview-bottom p { max-width:470px; color:#a5b5ae; font-size:14px; line-height:1.9; } .overview-bottom a { font-size:12px; white-space:nowrap; } .overview-bottom a span { margin-left:12px; color:#c7f277; }
 .section-label { display:flex; justify-content:space-between; align-items:center; gap:15px; padding:18px 0; border-top:1px solid #34403d; font:10px/1.5 Consolas,monospace; color:#a5b5ae; } .section-label h2 { font:inherit; color:#d6e3da; }
 .project article { background:#1b2522; border:1px solid #39493f; padding:30px; margin:4px 0 50px; }
 .project-heading { display:flex; justify-content:space-between; gap:20px; align-items:center; } .project h3 { font-size:40px; letter-spacing:-.05em; margin-top:9px; font-weight:500; } .project-heading>a { display:grid; place-items:center; width:48px; height:48px; background:#c7f277; color:#1a2619; text-decoration:none; font-size:28px; }
 .description { font-size:14px; color:#bac8bf; margin-top:22px; max-width:650px; }
 .system-map { margin:28px 0 20px; padding:22px; border:1px solid #3e5045; background:radial-gradient(#354339 1px,transparent 1px) 0 0/14px 14px,#131d18; }
 figcaption { font:10px/1.6 Consolas,monospace; color:#b2c3b6; } figcaption span { display:block; font:10px/1.6 sans-serif; margin-top:3px; }
 .map { display:grid; grid-template-columns:1fr 20px 1.5fr 20px 1fr; align-items:center; margin:28px 0; } .map-node,.map-core { background:#1b2820; text-align:center; border:1px solid #53634e; padding:16px 6px; font:12px/1.5 Consolas,monospace; } .map-core { border-color:#c7f277; color:#d5f5a3; font-size:18px; padding:24px 6px; } .map small { display:block; font-size:10px; color:#b5c6b9; margin-top:5px; } .connector { color:#6a835e; text-align:center; } .map-foot { display:flex; gap:12px; justify-content:space-around; font-size:11px; color:#bbcdbe; }
 .repo { display:flex; justify-content:space-between; gap:15px; font:11px/1.7 Consolas,monospace; overflow-wrap:anywhere; }
 .focus-grid { display:grid; grid-template-columns:1fr 1fr; margin-bottom:48px; gap:1px; background:#34403d; border:1px solid #34403d; } .focus-grid article { padding:24px; background:#111717; } .number { font:11px Consolas,monospace; color:#c7f277; } .focus h3 { font-size:17px; font-weight:500; margin:20px 0 9px; } .focus p { color:#a5b5ae; font-size:12px; }
 .education { display:grid; grid-template-columns:1fr 1.5fr auto; padding:26px 0; gap:24px; border-bottom:1px solid #34403d; } .education>p { font:11px/1.8 Consolas,monospace; color:#a5b5ae; } .education h3 { font-size:20px; font-weight:500; margin-bottom:10px; } .education div p { font-size:13px; } .department { color:#a5b5ae; }
 footer { padding:70px 0 40px; } footer h2 { font-size:clamp(38px,5vw,68px); letter-spacing:-.06em; margin:20px 0; font-weight:450; } footer h2 span { color:#c7f277; } address { display:flex; gap:36px; flex-wrap:wrap; font-size:14px; } .footer-note { margin-top:34px; font-size:11px; color:#a5b5ae; }
 @media(max-width:900px) { .lab { grid-template-columns:155px minmax(0,1fr); } .rail { padding:30px 20px; } main { padding:0 28px; } .overview-bottom { grid-template-columns:1fr; gap:20px; } .map { grid-template-columns:1fr; gap:8px; margin:18px 0; } .connector { display:none; } .map-core { order:-1; } }
 @media(max-width:600px) { .lab { display:block; } .rail { position:static; min-height:0; border-right:0; border-bottom:1px solid #34403d; padding:18px 20px; flex-direction:row; align-items:center; gap:20px; } .monogram { font-size:28px; } .rail-label,.rail-github { display:none; } .rail nav { display:flex; gap:14px; margin:0; flex-wrap:wrap; } .rail nav a { font-size:0; padding:4px 0; } .rail nav a span { margin:0; font-size:11px; } main { padding:0 20px; } .topline { font-size:9px; } .topline>span:last-child { display:none; } .overview { padding:34px 0; } .project article { padding:20px; } .project h3 { font-size:30px; } .project-heading>a { width:36px; height:36px; flex-shrink:0; } .system-map { padding:14px; } .map-foot { flex-wrap:wrap; } .focus-grid article { padding:18px; } .focus h3 { font-size:15px; overflow-wrap:anywhere; } .education { grid-template-columns:1fr; gap:12px; } .education>span { display:none; } }
</style>
