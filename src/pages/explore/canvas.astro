---
import Layout from '../../layouts/ExplorationLayout.astro';
import { profile, education, skills } from '../../data/profile';
import { projects } from '../../data/projects';
---
<Layout title="03 · 开放画布" direction="canvas">
  <div class="canvas">
    <header><a class="brand" href="#main">钱星宇<span>Xingyu Qian</span></a><nav aria-label="页面导航"><a href="#projects">作品</a><a href="#about">关于我</a><a href="#contact">聊聊 ↗</a></nav></header>
    <main id="main" tabindex="-1">
      <section class="intro" aria-labelledby="title"><div class="intro-copy"><p class="eyebrow">你好，我是钱星宇。</p><h1 id="title">思考系统，<br/>也让想法<br/><span>落到实处。</span></h1><p class="intro-bio">{profile.title}<br/>关注 Coding Agent，以及让它可靠运行的基础设施。</p><a class="pill" href="#projects">从项目认识我 <span>↘</span></a></div><div class="composition" aria-hidden="true"><div class="orbit"></div><div class="orange-disc"></div><div class="blue-tile"><span>思考</span><span>↗</span><small>THINK IN SYSTEMS</small></div><div class="cream-tile"><span>构建</span><small>BUILD WITH CARE</small><div class="lines"><i></i><i></i><i></i><i></i></div></div><span class="composition-caption">IDEAS ↔ SYSTEMS</span></div></section>
      <section id="projects" class="projects" aria-labelledby="work-title"><div class="heading-row"><h2 id="work-title">从想法到项目<span>Selected work</span></h2><span class="section-no">01</span></div>{projects.map(project=><article class="project"><div class="project-art" aria-hidden="true"><span class="art-label">TINY / HARNESS</span><div class="brackets"><span>[</span><span class="core">t<span>h</span></span><span>]</span></div><span class="art-foot">A SMALL HARNESS.<br/>A SPACE FOR AGENTS.</span></div><div class="project-copy"><p class="eyebrow">CODING AGENT HARNESS</p><h3>{project.name}</h3><p>{project.description}</p><ul>{project.tags.map(tag=><li>{tag}</li>)}</ul><a href={project.url}>打开 GitHub 仓库 <span>↗</span></a></div></article>)}</section>
      <section id="about" class="about" aria-labelledby="about-title"><div class="about-note"><p class="eyebrow">ABOUT / 关于我</p><h2 id="about-title">保持好奇，<br/>持续构建。</h2><p>{profile.about}</p><a href={profile.github}>在 GitHub 找到我 ↗</a><span class="asterisk" aria-hidden="true">✳</span></div><div class="background"><h3 class="small-title">教育背景</h3>{education.map(item=><article class="school"><p class="date">{item.period}</p><h4>{item.school}</h4><p>{item.degree}</p>{item.department&&<p class="department">{item.department}</p>}</article>)}</div></section>
      <section class="interests" aria-labelledby="interests-title"><div class="heading-row"><h2 id="interests-title">正在关注的方向<span>Areas of interest</span></h2><span class="section-no">02</span></div><div class="interest-list">{skills.map((skill,i)=><details><summary><span class="detail-no">0{i+1}</span><span>{skill.name}</span><span class="plus" aria-hidden="true">+</span></summary><p>{skill.detail}</p></details>)}</div><p class="hint">展开条目，了解具体关注内容。</p></section>
      <footer id="contact"><p class="eyebrow">项目、想法，或一次新的合作。</p><h2>很高兴认识你<span>↗</span></h2><address><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>GitHub ↗</a></address><div class="footer-bottom"><span>钱星宇 / Xingyu Qian</span><a href="#main">回到顶部 ↑</a></div></footer>
    </main>
  </div>
</Layout>
<style>
 :global(body) { background:#f9f8f3; color:#252830; } .canvas { width:min(1160px,calc(100% - 96px)); margin:auto; }
 header { display:flex; justify-content:space-between; align-items:center; padding:28px 0; gap:20px; } .brand { font-size:18px; font-weight:700; text-decoration:none; } .brand span { display:block; font-size:10px; font-weight:500; letter-spacing:.06em; margin-top:2px; } nav { display:flex; gap:28px; font-size:13px; } nav a { text-decoration:none; }
 .intro { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:30px; padding:50px 0 88px; } .eyebrow { font-size:11px; letter-spacing:.06em; }
 h1 { font-size:clamp(48px,5.6vw,76px); line-height:1.25; font-weight:650; letter-spacing:-.055em; margin:20px 0; } h1>span { color:#374bd0; } .intro-bio { font-size:13px; line-height:1.9; color:#61636c; margin:25px 0; }
 .pill { display:inline-flex; gap:26px; align-items:center; border:1px solid #252830; border-radius:40px; padding:10px 18px; text-decoration:none; font-size:12px; } .pill:hover { background:#252830; color:#fff; }
 .composition { position:relative; height:450px; margin-top:20px; } .orbit { width:340px; height:340px; border:1px solid #c5c5c4; border-radius:50%; position:absolute; top:45px; left:50%; transform:translateX(-50%); } .orange-disc { width:148px; height:148px; background:#db673d; border-radius:50%; position:absolute; right:6%; top:0; }
 .blue-tile { background:#374bd0; color:#fff; width:240px; height:255px; padding:28px; position:absolute; top:64px; left:0; transform:rotate(-8deg); border-radius:4px; display:flex; align-content:space-between; flex-wrap:wrap; justify-content:space-between; box-shadow:0 15px 24px #29285312; } .blue-tile>span { font-size:42px; } .blue-tile small { font-size:10px; width:100%; }
 .cream-tile { width:215px; height:230px; background:#e9e5d9; border:1px solid #d1ccbe; position:absolute; bottom:5px; right:2%; transform:rotate(8deg); padding:24px; border-radius:4px; } .cream-tile>span { font-size:35px; } .cream-tile small { display:block; font-size:9px; letter-spacing:.07em; } .lines { display:grid; gap:9px; margin-top:30px; } .lines i { height:2px; background:#343c60; } .lines i:nth-child(2) { width:75%; } .lines i:nth-child(3) { width:90%; } .lines i:last-child { width:50%; } .composition-caption { position:absolute; bottom:0; left:5%; font-size:9px; letter-spacing:.12em; }
 .heading-row { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:30px; } .heading-row h2 { font-size:27px; font-weight:550; letter-spacing:-.025em; } .heading-row h2 span { display:block; font:12px/1.6 Georgia,serif; color:#74747c; margin-top:10px; } .section-no { font:42px/1 Georgia,serif; color:#858590; }
 .project { display:grid; grid-template-columns:1fr 1.1fr; background:#eeeee7; border-radius:16px; overflow:hidden; }
 .project-art { background:#dce2fb; padding:30px; display:flex; flex-direction:column; justify-content:space-between; min-height:360px; color:#3549b7; } .art-label { font-size:10px; letter-spacing:.14em; } .brackets { display:flex; align-items:center; justify-content:center; gap:20px; font:300 125px/1 Georgia,serif; } .core { font:italic 80px/1 Georgia,serif; letter-spacing:-.15em; } .core>span { color:#6e80d5; } .art-foot { font-size:9px; letter-spacing:.12em; }
 .project-copy { padding:38px; } .project h3 { font-size:38px; letter-spacing:-.045em; margin:12px 0 20px; font-weight:600; } .project-copy>p:not(.eyebrow) { font-size:14px; line-height:1.9; color:#535660; } .project ul { display:flex; gap:7px; flex-wrap:wrap; margin:20px 0 30px; } .project li { font-size:10px; border:1px solid #c8c9bf; padding:4px 8px; border-radius:30px; } .project-copy>a { display:flex; justify-content:space-between; border-bottom:1px solid #b6b7ae; padding-bottom:10px; text-decoration:none; font-size:13px; }
 .about { display:grid; grid-template-columns:1fr 1fr; gap:90px; padding:90px 0; } .about-note { position:relative; padding-bottom:65px; } .about-note h2 { font-size:39px; font-weight:550; line-height:1.4; letter-spacing:-.04em; margin:22px 0; } .about-note>p:not(.eyebrow) { font-size:14px; max-width:380px; color:#61636c; } .about-note>a { display:inline-block; margin-top:20px; font-size:12px; } .asterisk { position:absolute; right:10px; bottom:0; font-size:68px; line-height:1; color:#db673d; } .small-title { font-size:14px; font-weight:500; border-bottom:1px solid #cbcbd0; padding-bottom:18px; } .school { border-bottom:1px solid #cbcbd0; padding:24px 0; } .date { font-size:11px; color:#61636c; } .school h4 { font-size:24px; font-weight:550; margin:12px 0; } .school>p:not(.date) { font-size:13px; } .department { color:#61636c; }
 .interest-list { border-top:1px solid #b9bac1; } details { border-bottom:1px solid #b9bac1; } summary { display:flex; align-items:center; gap:28px; padding:22px 0; cursor:pointer; list-style:none; font-size:clamp(17px,2.3vw,27px); letter-spacing:-.025em; } summary::-webkit-details-marker { display:none; } .detail-no { color:#767780; font-size:11px; letter-spacing:0; } .plus { margin-left:auto; font-size:27px; color:#374bd0; } details[open] .plus { transform:rotate(45deg); } details>p { padding:0 0 24px 42px; font-size:14px; color:#535660; } .hint { font-size:11px; color:#61636c; margin-top:16px; }
 footer { background:#374bd0; color:white; margin:80px -28px 24px; border-radius:18px; padding:42px 40px 22px; } footer h2 { font-size:clamp(34px,5vw,60px); font-weight:500; letter-spacing:-.04em; margin:20px 0 30px; } footer h2>span { margin-left:30px; } address { display:flex; gap:28px; flex-wrap:wrap; font-size:15px; } .footer-bottom { display:flex; justify-content:space-between; gap:20px; font-size:10px; border-top:1px solid #8896ef; padding-top:18px; margin-top:46px; }
 @media(max-width:900px) { .canvas { width:calc(100% - 56px); } .composition { transform:scale(.85); transform-origin:center; } .blue-tile { width:200px; } .cream-tile { width:190px; } .orbit { width:280px; height:280px; } .about { gap:45px; } .project-copy { padding:28px; } }
 @media(max-width:650px) { .canvas { width:calc(100% - 40px); } header { padding:22px 0; } nav { gap:18px; font-size:12px; } .intro { grid-template-columns:1fr; padding:32px 0 48px; gap:0; } h1 { font-size:54px; } .composition { height:345px; width:min(100%,350px); margin:20px auto 0; transform:none; } .blue-tile { width:185px; height:200px; top:40px; left:10px; } .blue-tile>span { font-size:34px; } .cream-tile { width:160px; height:180px; right:10px; padding:18px; } .cream-tile>span { font-size:28px; } .lines { margin-top:18px; gap:7px; } .orange-disc { width:110px; height:110px; } .orbit { width:260px; height:260px; } .composition-caption { font-size:8px; } .project,.about { grid-template-columns:1fr; } .project-art { min-height:280px; } .project-copy { padding:26px; } .project h3 { font-size:34px; } .about { padding:60px 0; gap:35px; } .heading-row h2 { font-size:24px; } summary { gap:16px; } footer { margin:55px 0 20px; padding:28px 22px 20px; } footer h2 { font-size:31px; } footer h2>span { margin-left:12px; } address { font-size:13px; gap:16px; } }
 @media(max-width:650px) { .composition { height:270px; width:min(100%,300px); margin-top:26px; } .blue-tile { width:160px; height:165px; top:24px; padding:20px; } .blue-tile>span { font-size:29px; } .blue-tile small { font-size:8px; } .cream-tile { width:140px; height:155px; padding:16px; } .cream-tile>span { font-size:24px; } .cream-tile small { font-size:8px; } .orange-disc { width:88px; height:88px; } .orbit { width:220px; height:220px; top:20px; } .lines { margin-top:14px; } }
</style>
