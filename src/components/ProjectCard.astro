---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project-card">
  <p class="eyebrow">{project.category}</p>
  <h3><a href={project.url}>{project.name}<span aria-hidden="true"> ↗</span></a></h3>
  <p class="project-description">{project.description}</p>
  <ul class="tags" aria-label={`${project.name} 技术主题`}>
    {project.tags.map(tag => <li>{tag}</li>)}
  </ul>
  <a class="text-link" href={project.url}>查看 GitHub 仓库 <span aria-hidden="true">↗</span></a>
</article>
